#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
export BUNDLE_PATH="${BUNDLE_PATH:-$HOME/.local/share/development-adventures-bundle}"
export JEKYLL_ENV="${JEKYLL_ENV:-production}"

exec "$HOME/.local/share/gem/ruby/3.3.0/bin/bundle" exec jekyll serve \
  --config _config.yml,_config_lan.yml \
  --destination _site_lan \
  --host 0.0.0.0 \
  --port "${PORT:-4000}" \
  --no-watch
